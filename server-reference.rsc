# ============================================================
# MikroTik hAP lite - REFERENCE CONFIGURATION: SERVER (exit site)
# ============================================================
# The exit site: all traffic from client sites leaves the internet
# with this site's own public IP.
#
# This MikroTik connects to your own ISP-provided router, just like
# every client site does (see README.md). That ISP router needs to
# forward the WireGuard UDP port to whatever IP this router gets on
# its uplink interface.
#
# The uplink is referenced through an interface list called WAN, so
# switching between a wired and a wireless uplink is a two-line
# change instead of a rewrite of every firewall rule. See the
# "ALTERNATIVE: UPLINK OVER WIFI" section at the end.
#
# Replace every <PLACEHOLDER> with a real value before importing.
# Never reuse keys from another router.
# ============================================================

# ---- Uplink definition (wired by default; see alternative at the end) ----
/interface list
add name=WAN

/interface list member
add interface=ether1 list=WAN

/ip dhcp-client
add interface=ether1

# ---- WireGuard ----
/interface wireguard
add listen-port=13231 mtu=1420 name=wireguard

# One "peer" block per client site that gets onboarded.
# The public key is generated by the client itself - a peer's private
# key is NEVER shared or uploaded here. Tunnel IP: one per client,
# unique, inside 172.16.0.0/24.
#
# NOTE - do NOT set persistent-keepalive on the server side. Doing so
# makes the server try to initiate a handshake every 25s against peers
# whose endpoint it doesn't know (roaming clients that aren't connected
# right now), in a permanent loop that burns CPU on hardware that has
# none to spare. Keepalive belongs on the CLIENT, which is the side
# sitting behind its ISP's NAT and needing to keep that mapping alive.
/interface wireguard peers
add allowed-address=172.16.0.<N>/32 client-address=172.16.0.<N>/32 \
    comment="MikroTik <SiteName>" interface=wireguard \
    public-key="<CLIENT_PUBLIC_KEY>"

/ip address
add address=172.16.0.1/24 interface=wireguard network=172.16.0.0

/ip dns
set allow-remote-requests=no servers=8.8.8.8,1.1.1.1
# Keep allow-remote-requests=no: client sites hand 8.8.8.8 straight to
# their own LAN devices over DHCP, so nothing queries this router as a
# resolver. Turning it on would expose an open resolver for no benefit.
# (If you configure a phone/app peer with DNS = 172.16.0.1, that peer
# would depend on it - decide deliberately, don't enable it by default.)

/ip firewall nat
add action=masquerade chain=srcnat src-address=172.16.0.0/24 \
    comment="Give the whole WireGuard mesh internet access"

/ip firewall filter
# --- Isolate this site's own local network from the rest of the mesh ---
# Without this, any client site (with allowed-address 0.0.0.0/0 on its
# own side) could reach your own household devices.
add chain=forward action=drop in-interface=wireguard \
    dst-address=<MAIN_SITE_LAN>/24 \
    comment="Block traffic to local network"

# --- Protect the router itself ---
# Note: if (as is typical) this MikroTik sits behind another ISP-provided
# router, the uplink carries your own LAN traffic as well as the forwarded
# VPN traffic. That's why management is allowed by source address rather
# than by assuming everything on the uplink is hostile.
add chain=input action=accept connection-state=established,related \
    comment="Replies to connections this router itself started"
add chain=input action=accept src-address=<MAIN_SITE_LAN>/24 \
    comment="Allow management from the local network"
add chain=input action=accept in-interface=wireguard \
    comment="Allow management over the VPN tunnel"
add chain=input action=accept protocol=udp dst-port=13231 \
    comment="Allow the WireGuard handshake forwarded from the ISP router"
add chain=input action=accept protocol=udp src-port=67 dst-port=68 \
    in-interface-list=WAN comment="Allow DHCP replies"
add chain=input action=accept protocol=icmp comment="Allow ping"
add chain=input action=drop in-interface-list=WAN \
    comment="Drop anything else arriving on the uplink"

/ip firewall mangle
add chain=forward protocol=tcp tcp-flags=syn action=change-mss \
    new-mss=clamp-to-pmtu passthrough=yes comment="MSS clamp WG"

/ip service
# telnet and ftp are cleartext; the API isn't used here. Keep ssh and
# winbox, and decide about www deliberately: that one is WebFig, the
# router's web interface. Disabling it is fine only if you never
# administer the box from a browser - it is an easy thing to turn off
# by accident and then wonder why the web UI stopped answering.
set telnet disabled=yes
set ftp disabled=yes
set api disabled=yes
set api-ssl disabled=yes

/system clock
set time-zone-name=<YOUR_TIMEZONE>

/system identity
set name="VPN Server"

/system routerboard settings
set auto-upgrade=no
# Keep this off. It doesn't download new RouterOS, but it does flash the
# RouterBOOT bootloader on the next boot to match the installed RouterOS.
# You want that to happen deliberately, with someone able to power-cycle
# the device, not during an unplanned reboot.

# ---- Dynamic DNS ----
# This site has no static IP, so a hostname has to be kept updated with
# the current public IP.
/system scheduler
add interval=30m name=dns_update on-event=ddns_update start-time=startup \
    policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon
add interval=23h59m59s name=dns_update_force on-event=ddns_update_force \
    start-time=startup \
    policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
    comment="Forces a DDNS update so a free host doesn't expire from inactivity"

/system script
add name=ddns_update owner=admin dont-require-permissions=no \
    policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
    source={
        :local DDNSUSER "<DDNS_USERNAME>";
        :local DDNSPASS "<DDNS_PASSWORD>";
        :local DDNSHOST "<your-host>.example.com";

        :local ipResult [/tool fetch url="https://api.ipify.org" as-value output=user];
        :if ([:typeof $ipResult] = "nothing") do={
            :log error "Could not obtain the public IP from api.ipify.org";
            :return;
        }
        :local IPROUTER ($ipResult->"data");

        :local IPDDNS "";
        :do { :set IPDDNS [:resolve $DDNSHOST]; } on-error={ :log warning "Could not resolve $DDNSHOST" };
        :if ([:typeof $IPDDNS] != "ip") do={ :return; }

        :if ($IPROUTER != $IPDDNS) do={
            :local updateUrl "http://$DDNSUSER:$DDNSPASS@your-ddns-provider.example/update?hostname=$DDNSHOST&myip=$IPROUTER";
            :local response [/tool fetch url=$updateUrl as-value output=user];
            :if ([:typeof $response] = "nothing") do={
                :log error "No response from the DDNS provider";
                :return;
            }
            :log info ("DDNS update result: ".($response->"data"));
        } else={
            :log info "Public IP already matches DDNS ($IPROUTER), nothing to update.";
        }
    }

add name=ddns_update_force owner=admin dont-require-permissions=no \
    policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
    comment="Forces a DDNS update on the 1st and 15th of every month" \
    source={
        :local DDNSUSER "<DDNS_USERNAME>";
        :local DDNSPASS "<DDNS_PASSWORD>";
        :local DDNSHOST "<your-host>.example.com";

        :local dayOfMonth [:pick [/system clock get date] 0 2];
        :if (($dayOfMonth != "01") and ($dayOfMonth != "15")) do={ :return; }

        :local ipResult [/tool fetch url="https://api.ipify.org" as-value output=user];
        :if ([:typeof $ipResult] = "nothing") do={
            :log error "Could not obtain the public IP from api.ipify.org";
            :return;
        }
        :local IPROUTER ($ipResult->"data");
        :local updateUrl "http://$DDNSUSER:$DDNSPASS@your-ddns-provider.example/update?hostname=$DDNSHOST&myip=$IPROUTER";
        :local response [/tool fetch url=$updateUrl as-value output=user];
        :if ([:typeof $response] = "nothing") do={
            :log error "No response from the DDNS provider";
            :return;
        }
        :log info ("DDNS forced update result: ".($response->"data"));
    }

# ============================================================
# ALTERNATIVE: UPLINK OVER WIFI
# ============================================================
# Use this when the server router reaches the ISP router over WiFi
# instead of a cable - either as the primary uplink, or kept ready as
# a standby for when the cable fails.
#
# Everything above stays as it is. Only the uplink definition changes:
# wlan1 becomes a station joining the ISP router's network, and it is
# what goes into the WAN list. Every firewall rule already refers to
# the list, so none of them need editing.
#
# Keeping this configured but disabled costs nothing and gives you a
# fallback path. If you do that, expect /ip dhcp-client on wlan1 to
# show up as invalid while the interface is disabled - that is normal,
# not leftover junk.
#
#   /interface wireless security-profiles
#   add name=isp_uplink mode=dynamic-keys authentication-types=wpa2-psk \
#       wpa2-pre-shared-key="<ISP_WIFI_PASSWORD>"
#
#   /interface wireless
#   set [find default-name=wlan1] mode=station ssid="<ISP_WIFI_SSID>" \
#       security-profile=isp_uplink band=2ghz-b/g/n country=<YOUR_COUNTRY> \
#       disabled=no
#
#   /ip dhcp-client
#   add interface=wlan1
#
#   /interface list member
#   add interface=wlan1 list=WAN
#
# With a WiFi uplink, ether1 is free and can be used as a management
# port. If WiFi is the only uplink, remove ether1 from the WAN list and
# remove its dhcp-client so nothing expects an address there.
